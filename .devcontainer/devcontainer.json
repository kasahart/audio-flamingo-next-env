{
  "name": "Audio Flamingo Next (GPU)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // NVIDIA GPU access configuration for RTX PRO 6000 Blackwell
  "runArgs": [
    "--gpus",
    "all",
    "--shm-size",
    "16g"
  ],
  "containerEnv": {
    "CUDA_VISIBLE_DEVICES": "0",
    "PYTHONPATH": "/workspace"
  },
  // VS Code extensions for Python and AI/ML development
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.terminal.activateEnvironment": false,
        "editor.formatOnSave": true,
        "editor.rulers": [120]
      }
    }
  },
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
  ],
  // Post-creation commands: configure git-lfs for large model files
  "postCreateCommand": "git lfs install && echo 'DevContainer ready! GPU: ' && python3 -c \"import torch; print(f'CUDA available: {torch.cuda.is_available()}'); print(f'GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else None}')\"",
  "remoteUser": "root"
}
